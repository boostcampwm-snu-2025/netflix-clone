{
  "name": "netflix-clone",
  "version": "1.0.0",
  "description": "넷플릭스 클론 프로젝트",
  "main": "index.js",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:js": "prettier --write \"src/**/*.{js,jsx}\"",
    "format:css": "prettier --write \"src/**/*.{css,scss}\"",
    "format:html": "prettier --write \"src/**/*.html\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,scss,html,json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "netflix",
    "clone",
    "react",
    "javascript"
  ],
  "author": "",
  "license": "ISC"
}
